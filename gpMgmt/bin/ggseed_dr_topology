#!/bin/bash
#
# ggseed_dr_topology -- frozen-tuple seed of a DR replica's cluster topology
#                       (Greengage disaster-recovery PoC, milestone M1.5)
#
# A read-only DR replica's gp_segment_configuration must describe the *DR*
# cluster, not production.  After a DR node is created by restoring a base
# backup, that shared catalog still holds production's rows.  This script
# replaces them with DR-local rows and FREEZES the table, so the rows have
# xmin = FrozenTransactionId and are unconditionally visible -- with no
# dependency on the commit log, which production's replayed WAL will later
# overwrite.
#
# It must run on a STOPPED DR coordinator data directory, BEFORE standby.signal
# is placed and continuous restore begins.  Combined with the apply-time redo
# filter (gp_dr_replica), the frozen rows then survive replay: the filter skips
# production's WAL records for the protected topology catalogs, so the DR pages
# are never overwritten, and the frozen tuples stay visible without CLOG.
#
# Usage:
#   ggseed_dr_topology <coordinator_datadir> <dr_topology.tsv>
#
# dr_topology.tsv: one tab-separated line per segment instance, columns:
#   dbid <TAB> content <TAB> role <TAB> preferred_role <TAB> mode <TAB> \
#   status <TAB> port <TAB> hostname <TAB> address <TAB> datadir
# (role/preferred_role in {p,m}; mode in {s,n}; status in {u,d}.)
#
# NOTE (PoC): this is the focused frozen-seed step only.  Allocating DR dbids,
# restoring the base backup with --target-gp-dbid, and writing restore_command /
# arming gp_dr_replica + dr_replica.signal belong to the create utility (M4).
#
# CRITICAL (M4): the single-user run below CONSUMES backup_label, advances
# pg_control past the backup LSN, and appends the seed's OWN WAL onto the
# backup-end segment in pg_wal.  The caller MUST preserve the recovery-start
# state around this seed (copy backup_label + global/pg_control aside before, and
# restore them after) so recovery resumes from the backup checkpoint; the seed's
# frozen gp_segment_configuration pages are higher-LSN but protected (filtered),
# so they persist.  Validated end-to-end by src/test/dr (DR_SEED=1).
#
# OPEN BLOCKER (found by adversarial review, NOT yet fixed): restoring
# backup_label + pg_control rewinds the control file but leaves the seed's forked
# WAL on the backup-end segment in pg_wal.  Recovery resumes correctly ONLY
# because it fetches [REDO..end] from the ARCHIVE first (archive precedence
# overwrites the local segment) -- safe IFF the archive holds every segment
# [REDO..end] before the replica requests it.  The fixture guarantees this
# (production force-archives, then the DR waits on restorepoint_ready); the real
# create utility MUST enforce archive-completeness (poll + fail closed), because
# on an archive miss recovery would replay the seed's WAL -- its non-protected
# pg_class freeze record applies and its CHECKPOINT becomes a restartpoint ->
# PERMANENT timeline fork.  NB: naive pg_wal deletion/restore is NOT a fix (it
# breaks the checkpoint read); the robust fix is to re-fetch [REDO..end] from the
# archive into pg_wal, or to gate arming on an archive-completeness check.
#
# CAVEAT (freeze footprint, bounded + self-healing): VACUUM FREEZE does in-place
# relstats updates for FIVE pg_class rows -- the heap 5036, indexes 7139/7140,
# and the recursively-vacuumed toast 6092/6093 -- landing on 2-3 pg_class pages.
# pg_class (1259) is not protected, so production changes co-located on those
# pages within the (backup-LSN, seed-LSN] window (an LSN range = the seed's WAL
# volume, not a wall-clock instant) are LSN-shadowed until the page's next
# production FPI heals them.  Harmless on a read-only replica; the real create
# utility should seed against a scratch copy and transplant back only the
# protected forks (5036/7139/7140/6092/6093).
#
set -euo pipefail

prog=$(basename "$0")

die() { echo "$prog: $*" >&2; exit 1; }

[ $# -eq 2 ] || {
	echo "usage: $prog <coordinator_datadir> <dr_topology.tsv>" >&2
	exit 2
}
datadir=$1
topology=$2

[ -d "$datadir" ]   || die "no such data directory: $datadir"
[ -f "$topology" ]  || die "no such topology file: $topology"
command -v postgres >/dev/null || die "postgres not found on PATH (source greengage_path.sh)"
[ -e "$datadir/postmaster.pid" ] && die "coordinator at $datadir appears to be running; stop it first"
[ -e "$datadir/standby.signal" ] && die "$datadir is already in standby mode; seed before placing standby.signal"

# Turn each topology line into an INSERT.  Single-quoted text columns are escaped
# by doubling embedded quotes.
inserts=$(awk -F'\t' '
	function q(s) { gsub(/\x27/, "\x27\x27", s); return "\x27" s "\x27" }
	NF < 10 { next }
	{
		printf "INSERT INTO gp_segment_configuration (dbid, content, role, preferred_role, mode, status, port, hostname, address, datadir) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s);\n", \
			$1, $2, q($3), q($4), q($5), q($6), $7, q($8), q($9), q($10)
	}
' "$topology")

[ -n "$inserts" ] || die "topology file $topology produced no rows (need >=10 tab-separated columns)"

rows=$(printf '%s\n' "$inserts" | grep -c '^INSERT')
echo "$prog: seeding $rows DR-local topology rows into $datadir ..."

# Single-user mode runs each statement autocommitted, so VACUUM FREEZE and
# CHECKPOINT are allowed.  allow_system_table_mods permits direct DML on the
# gp_segment_configuration system catalog; gp_role=utility keeps the standalone
# backend from trying to act as a dispatcher.
postgres --single -D "$datadir" \
	-c gp_role=utility \
	-c allow_system_table_mods=on \
	template1 <<SQL
DELETE FROM gp_segment_configuration;
$inserts
VACUUM FREEZE gp_segment_configuration;
CHECKPOINT;
SQL

echo "$prog: done -- gp_segment_configuration replaced and frozen."
echo "$prog: next, arm DR mode (gp_dr_replica=on + dr_replica.signal + restore_command) and start continuous restore."
