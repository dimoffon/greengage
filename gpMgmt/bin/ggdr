#!/usr/bin/env python3
"""ggdr -- control a Greengage DR read-replica's recovery.

A DR read-replica is a second Greengage cluster kept current from production via
WAL archiving and permanently in archive recovery.  Every node (coordinator +
each primary segment) replays independently; this tool drives the whole cluster
as one.

A replica recovers **up to a distributed restore point** and serves reads there.
That is the only supported serving state: a restore point is taken under
TwophaseCommitLock, so it is the one cut where no distributed transaction
straddles the segments.  There is deliberately no free-running mode -- reads
taken while replay advances have no cross-node guarantee to offer.

The cluster-wide steps below are also available as SQL, so a client that can
reach only the coordinator can drive recovery without this tool:

    SELECT gg_dr_switch('rp_hourly_42');      -- advance + wait, cluster-wide
    SELECT gg_dr_promote();                   -- promote at the current cut
    SELECT * FROM gg_stat_dr_replica_summary; -- status

Subcommands
-----------
  switch <restore_point>
        Stop-and-go: make every node pause at restore point <restore_point>, then
        start serving it.  A thin wrapper around gg_dr_switch() on the coordinator
        -- see there for why the serving step has to be cluster-wide.  Reads keep
        answering as of the PREVIOUS point for the whole advance, and flip to the
        new one together.  <restore_point> must be AHEAD of where the cluster is
        now (recovery only moves forward); arming it before production creates it
        is fine.  Calling it with the point the cluster is already stopped at is
        a no-op re-publish, not a runaway.

  pause
        Immediately pause replay on every node at its current point.  This is NOT
        a cross-node consistent cut (each node halts wherever it happens to be),
        so it is for inspection: it stops the WAL from moving, it does not change
        what reads see.  Reads go on answering as of the last restore point the
        cluster switched to.  Resume with 'switch <rp>'.

  stat
        Print per-node recovery statistics and a cluster summary: in recovery?
        paused? served restore point, replay LSN, replay age, and whether there is
        a consistent serve point (all nodes paused at the same restore point).

  promote [--at <rp>] [--yes] [--timeout <secs>]
        Promote the DR cluster to a normal ONLINE read-write cluster, cutting every
        node at the SAME restore point.  Refuses unless all nodes are paused at one
        consistent restore point (== --at, if given).  pg_promote() + resume on
        every node, segments first then the coordinator, so each exits recovery
        exactly after that point.  DR behaviour is keyed on "in recovery with hot
        standby", so it disengages with recovery itself -- no restart.
        IRREVERSIBLE (recovery only moves forward).

  create-replica --topology <tsv> --basebackup-dir <dir> --wal-archive <dir>
                 [--restore-command <cmd>] [--pause-at <rp>] [--no-start] [--force]
        Build a DR replica: restore each instance's base backup (taken on
        production with pg_basebackup --target-gp-dbid) into its DR data dir, gate
        on the WAL archive being complete enough to reach consistency, write the
        DR-local cluster topology into every node's own topology store
        ($PGDATA/gp_topology, via gg_topology), arm the replica
        (gp_topology_source=file + hot_standby + restore_command + standby.signal)
        on every node, start each in archive recovery, and verify the replica
        describes itself.  Runs before any node is up, so the node list comes from
        the topology tsv.

        The topology is written to a file rather than to gp_segment_configuration
        because that catalog is replicated: production's rows arrive in the WAL the
        replica exists to replay.  A file is not replicated, so the replica simply
        keeps its own -- and the base backup's copy of production's file is
        overwritten here, before the first start.

Connection
----------
Run this on the DR coordinator host.  The coordinator is reached locally (via the
standard libpq environment: PGPORT, PGDATABASE, ...); the node list and each
segment's address/port come from the DR's own gp_segment_configuration.  All
connections are utility-mode (no dispatch), so switch/stat keep working even when
the cluster has no consistent serve point.
"""

import argparse
import os
import shutil
import subprocess
import sys
import time

COORD_PORT = int(os.environ.get("PGPORT", "7000"))
DB = os.environ.get("PGDATABASE", "postgres")
FIELDSEP = "\x1f"  # unit separator -- unambiguous vs restore-point names


def _psql(port, sql, host=None, timeout=60):
    """Run SQL in utility mode; return (rc, stdout, stderr) with output trimmed."""
    env = dict(os.environ)
    env["PGOPTIONS"] = "-c gp_role=utility " + env.get("PGOPTIONS", "")
    cmd = ["psql", "-p", str(port), "-d", DB, "-v", "ON_ERROR_STOP=0", "-qtAc", sql]
    if host:
        cmd[1:1] = ["-h", host]
    try:
        r = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (subprocess.TimeoutExpired, OSError) as e:
        return 1, "", str(e)


def get_nodes():
    """[(content, address, port)] for the coordinator + primary segments."""
    rc, out, err = _psql(
        COORD_PORT,
        "select content||'%s'||address||'%s'||port "
        "from gp_segment_configuration where role='p' order by content;" % (FIELDSEP, FIELDSEP),
    )
    if rc != 0 or not out:
        sys.exit("ggdr: cannot read gp_segment_configuration on the coordinator "
                 "(port %d): %s" % (COORD_PORT, err or "no rows"))
    nodes = []
    for line in out.splitlines():
        content, address, port = line.split(FIELDSEP)
        nodes.append((int(content), address, int(port)))
    return nodes


def _conn(content, address, port):
    """Return (host, port) for connecting to a node in utility mode.

    PoC / single-host demo: every node is co-located on this host, so each is
    reached by its LOCAL socket on its own port (the demo pg_hba grants
    'local ... trust', whereas a plain TCP psql to a segment is rejected by its
    pg_hba -- only the coordinator's privileged dispatch path connects by TCP).

    A multi-host deployment would instead connect to each segment by <address>
    with a matching pg_hba entry, or run this tool once per host; <address> is
    kept in the node list for exactly that.
    """
    return (None, port)


def _label(content):
    return "coordinator" if content == -1 else "segment %d" % content


def node_state(content, address, port):
    host, port = _conn(content, address, port)
    sql = (
        "select coalesce(pg_is_in_recovery()::text,'') ||'%(s)s'|| "
        "coalesce((case when pg_is_in_recovery() then pg_is_wal_replay_paused() else false end)::text,'') ||'%(s)s'|| "
        "coalesce(pg_last_paused_restore_point(),'') ||'%(s)s'|| "
        "coalesce(pg_last_wal_replay_lsn()::text,'') ||'%(s)s'|| "
        "coalesce(round(extract(epoch from now()-pg_last_xact_replay_timestamp()))::text,'');"
        % {"s": FIELDSEP}
    )
    rc, out, err = _psql(port, sql, host=host)
    if rc != 0 or not out:
        return {"content": content, "ok": False, "err": err or "no response"}
    parts = (out.split(FIELDSEP) + [""] * 5)[:5]
    inrec, paused, rp, lsn, age = parts
    truthy = ("t", "true")
    return {
        "content": content, "ok": True,
        "in_recovery": inrec in truthy,
        "paused": paused in truthy,
        "restore_point": rp,
        "replay_lsn": lsn,
        "replay_age": age,
    }


def _psql_dispatch(sql, timeout=None):
    """Run SQL on the coordinator in DISPATCH mode; return (rc, stdout, stderr).

    Everything else in this tool talks to each node in utility mode, on purpose:
    per-node inspection has to keep working when the cluster has no consistent
    serve point.  A switch is the exception -- it is a cluster-wide operation and
    must run where the cluster is driven from.

    timeout=None on purpose: how long a switch takes is a property of how much
    WAL lies between here and the target.  Ctrl-C kills psql, which cancels the
    query, which is how gg_dr_switch() is meant to be interrupted.
    """
    cmd = ["psql", "-p", str(COORD_PORT), "-d", DB, "-v", "ON_ERROR_STOP=1", "-qtAc", sql]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (subprocess.TimeoutExpired, OSError) as e:
        return 1, "", str(e)


def cmd_switch(restore_point):
    nodes = get_nodes()
    print("ggdr switch: re-pointing %d node(s) to restore point '%s'"
          % (len(nodes), restore_point))
    # Driven through gg_dr_switch() rather than node by node.  Re-pointing each
    # node directly would still get them all paused at the right place, but the
    # step that makes them START SERVING that place is cluster-wide: a node may
    # only publish its frozen image once EVERY node has arrived, and only the
    # coordinator knows when that is.  Done per node, the fast ones would serve
    # the new point while the slow ones still served the old one.
    print("ggdr switch: waiting for every node to reach '%s' "
          "(no timeout -- Ctrl-C cancels) ..." % restore_point)
    quoted = restore_point.replace("'", "''")
    rc, out, err = _psql_dispatch("select pg_catalog.gg_dr_switch('%s');" % quoted)
    if rc == 0 and out in ("t", "true"):
        print("ggdr switch: DONE -- all %d node(s) paused at '%s' "
              "(consistent serve point)" % (len(nodes), restore_point))
        return 0
    print("ggdr switch: FAILED -- %s"
          % (err.splitlines()[0] if err else "gg_dr_switch() did not report success"))
    states = [node_state(*n) for n in nodes]
    for s in states:
        if s["ok"]:
            print("  %-13s: paused=%s at '%s'"
                  % (_label(s["content"]), "yes" if s["paused"] else "no", s["restore_point"] or "-"))
        else:
            print("  %-13s: UNREACHABLE (%s)" % (_label(s["content"]), s["err"]))
    print("  (is '%s' a restore point production created AHEAD of the current point, "
          "and already archived?)" % restore_point)
    return 1


def cmd_pause():
    nodes = get_nodes()
    print("ggdr pause: pausing replay on %d node(s) at their current point" % len(nodes))
    for content, address, port in nodes:
        host, p = _conn(content, address, port)
        rc, out, err = _psql(p, "select pg_wal_replay_pause();", host=host)
        note = ""
        if err and "not in progress" not in err.lower():
            note = "  [warn: %s]" % err.splitlines()[0]
        print("  %-13s (port %d): paused%s" % (_label(content), port, note))
    print("ggdr pause: replay halted.")
    print("  NOTE: an IMMEDIATE pause halts each node wherever it is, which is NOT a")
    print("        cross-node consistent cut -- but it does not make one visible either:")
    print("        reads keep answering as of the last restore point 'switch' published.")
    print("        To move the served point, use 'switch <rp>'.")
    return 0


def cmd_stat():
    nodes = get_nodes()
    states = [node_state(*n) for n in nodes]

    print("ggdr: DR read-replica recovery status\n")
    hdr = "  %-8s %-11s %-11s %-6s %-22s %-16s %s"
    print(hdr % ("content", "role", "in_recovery", "paused", "restore_point", "replay_lsn", "replay_age"))
    print("  " + " ".join("-" * n for n in (8, 11, 11, 6, 22, 16, 10)))
    for s in states:
        role = "coordinator" if s["content"] == -1 else "segment"
        if not s["ok"]:
            print("  %-8s %-11s  UNREACHABLE: %s" % (s["content"], role, s["err"]))
            continue
        age = (s["replay_age"] + "s") if s["replay_age"] else "-"
        print(hdr % (s["content"], role,
                     "yes" if s["in_recovery"] else "no",
                     "yes" if s["paused"] else "no",
                     s["restore_point"] or "-", s["replay_lsn"] or "-", age))

    reachable = [s for s in states if s["ok"]]
    all_rec = bool(reachable) and all(s["in_recovery"] for s in reachable)
    all_paused = bool(reachable) and all(s["paused"] for s in reachable)
    any_paused = any(s["paused"] for s in reachable)
    served = set(s["restore_point"] for s in reachable if s["paused"])
    consistent = all_paused and len(served) == 1 and "" not in served
    ages = [int(s["replay_age"]) for s in reachable if s["replay_age"]]
    rpo = max(ages) if ages else None

    if not all_paused and any_paused:
        mode = "partially paused (advancing)"
    elif all_paused:
        mode = "all paused"
    else:
        mode = "advancing (no consistent cut)"
    print()
    print("  cluster: %d node(s), %s, %s"
          % (len(states), "all in recovery" if all_rec else "NOT all in recovery", mode))
    if consistent:
        print("  consistent serve point: %s   (safe to serve as-of-N reads)" % next(iter(served)))
    else:
        print("  consistent serve point: none   (advancing, or nodes skewed)")
    if rpo is not None:
        print("  RPO: ~%ds behind production's last replayed commit" % rpo)
    return 0


def _run(cmd, timeout=600, stdin=None):
    """Run a local subprocess (pg_ctl etc.); return (rc, stdout, stderr)."""
    try:
        r = subprocess.run(cmd, env=dict(os.environ), input=stdin,
                           capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (subprocess.TimeoutExpired, OSError) as e:
        return 1, "", str(e)


def get_datadirs():
    """{content: datadir} for the coordinator + primary segments (for pg_ctl in promote)."""
    rc, out, err = _psql(
        COORD_PORT,
        "select content||'%s'||datadir from gp_segment_configuration where role='p' order by content;" % FIELDSEP)
    dd = {}
    for line in out.splitlines():
        c, d = line.split(FIELDSEP)
        dd[int(c)] = d
    return dd


def _wait_out_of_recovery(node_tuples, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if all(node_state(*n).get("in_recovery") is False for n in node_tuples):
            return True
        time.sleep(2)
    return False


def cmd_promote(at=None, assume_yes=False, timeout=300):
    nodes = get_nodes()
    # --- precondition: every node paused at ONE consistent restore point (computed
    #     client-side over utility-mode reads, since the dispatched summary view
    #     breaks as nodes leave recovery). ---
    states = [node_state(*n) for n in nodes]
    if not all(s["ok"] for s in states):
        sys.exit("ggdr promote: some nodes are unreachable; refusing.")
    if not all(s["in_recovery"] for s in states):
        sys.exit("ggdr promote: not every node is in recovery; refusing.")
    if not all(s["paused"] for s in states):
        sys.exit("ggdr promote: not every node is paused -- run 'ggdr switch <rp>' "
                 "to reach a consistent restore point first.")
    served = set(s["restore_point"] for s in states)
    if len(served) != 1 or "" in served:
        sys.exit("ggdr promote: nodes are NOT at a single consistent restore point (%s); "
                 "run 'ggdr switch <rp>' first." % sorted(served))
    consistent_n = next(iter(served))
    if at and consistent_n != at:
        sys.exit("ggdr promote: cluster is at '%s', not --at '%s'; refusing." % (consistent_n, at))

    print("ggdr promote: promoting the whole cluster at consistent restore point '%s'"
          % consistent_n)
    if not assume_yes:
        sys.stderr.write("  This is IRREVERSIBLE (recovery only moves forward). Type 'yes' to continue: ")
        sys.stderr.flush()
        if sys.stdin.readline().strip().lower() != "yes":
            sys.exit("ggdr promote: aborted.")

    segs = [n for n in nodes if n[0] != -1]
    coord = next(n for n in nodes if n[0] == -1)

    # --- phase 1: exit recovery at N, SEGMENTS FIRST then COORDINATOR ---
    print("ggdr promote: phase 1 -- exiting recovery (segments first)")
    for content, address, port in segs:
        host, p = _conn(content, address, port)
        _psql(p, "select pg_promote(false);", host=host)      # arm the promote trigger
        _psql(p, "select pg_wal_replay_resume();", host=host)  # unpause -> recovery ends AFTER N
        print("  %-13s (port %d): promote armed + resumed" % (_label(content), port))
    if not _wait_out_of_recovery(segs, timeout):
        sys.exit("ggdr promote: segments did not exit recovery within %ds." % timeout)
    print("  all segments out of recovery")
    c, a, p_ = coord
    host, cp = _conn(c, a, p_)
    _psql(cp, "select pg_promote(false);", host=host)
    _psql(cp, "select pg_wal_replay_resume();", host=host)
    if not _wait_out_of_recovery([coord], timeout):
        sys.exit("ggdr promote: coordinator did not exit recovery within %ds." % timeout)
    print("  coordinator out of recovery")

    # Nothing else to do: DR behaviour is keyed on "in recovery with hot standby"
    # (IsDRReplicaMode), so it disengaged by itself the moment recovery ended.
    # There is no PGC_POSTMASTER GUC to unset and no marker file to remove, which
    # is why the old two-phase promote (and its cluster restart) is gone.
    #
    # standby.signal is left in place deliberately: a promoted node ignores it,
    # and removing it here would only matter if the datadir were later reused.
    print("ggdr promote: DONE -- cluster promoted to online read-write "
          "(as-of restore point '%s'); DR mode disengaged with recovery, no restart needed."
          % consistent_n)
    return 0


#: the topology store's fields, in order.  A dr_topology.tsv line is exactly these
#: ten columns, tab-separated, which is also gg_topology's input format with a
#: different separator -- so a line round-trips with no transformation.
TOPO_FIELDS = ("dbid", "content", "role", "preferred_role", "mode", "status",
               "port", "hostname", "address", "datadir")


def _parse_topology(path):
    """Parse a dr_topology.tsv (>=10 tab cols, TOPO_FIELDS in order).

    Returns [dict(...)] ordered by content, each carrying all ten fields: the
    line is handed back to gg_topology later, so nothing may be dropped here --
    the old parser kept only the five it used.  Columns past the tenth are
    ignored, as they always were; a datadir containing a tab would land there and
    is caught by _topology_store_lines(), which rejects whitespace in any field.
    """
    rows = []
    with open(path) as f:
        for ln, line in enumerate(f, 1):
            line = line.rstrip("\n")
            if not line.strip():
                continue
            cols = line.split("\t")
            if len(cols) < 10:
                sys.exit("ggdr create-replica: %s:%d has %d columns, need >=10" % (path, ln, len(cols)))
            r = dict(zip(TOPO_FIELDS, cols[:10]))
            r["dbid"], r["content"], r["port"] = int(r["dbid"]), int(r["content"]), int(r["port"])
            rows.append(r)
    if not any(r["content"] == -1 for r in rows):
        sys.exit("ggdr create-replica: topology has no coordinator (content=-1) row")
    return sorted(rows, key=lambda r: r["content"])


def _topology_store_lines(rows):
    """Render the topology in gg_topology's input format: ten space-separated
    fields per line.  Whitespace inside a field would make the line ambiguous;
    gg_topology rejects that itself, but say so here rather than let a stray
    space surface as 'entry N cannot be written'."""
    out = []
    for r in rows:
        vals = [str(r[f]) for f in TOPO_FIELDS]
        for f, v in zip(TOPO_FIELDS, vals):
            if not v or v.split() != [v]:
                sys.exit("ggdr create-replica: dbid %s has an empty or "
                         "whitespace-containing %s (%r); the topology store is a "
                         "space-separated text file and cannot represent it."
                         % (r["dbid"], f, v))
        out.append(" ".join(vals))
    return "".join(l + "\n" for l in out)


def _check_topology(rows):
    """Post-build check: does the live replica describe *this* cluster?

    gp_segment_configuration is a view over whichever store gp_topology_source
    names, so asking the running coordinator answers the question that matters --
    not "was the file written" (gg_topology already said so) but "is the running
    coordinator serving it".  A replica that answers production's topology would
    dispatch to production's segments, which is the single thing the DR contract
    must never allow, so a mismatch fails the build.

    The coordinator is the node checked because the coordinator is what dispatches.
    Every node got its own copy of the same file; a segment disagreeing with it
    cannot be diagnosed from here anyway, and shows up as a failed gang.

    Returns 0 on a match, 1 otherwise.
    """
    port = next(r["port"] for r in rows if r["content"] == -1)
    want = ",".join("%d:%d:%d:%s" % (r["dbid"], r["content"], r["port"], r["hostname"])
                    for r in sorted(rows, key=lambda r: r["content"]))
    rc, out, err = _psql(port,
                         "select coalesce(string_agg(dbid||':'||content||':'||port||':'||hostname,"
                         "                           ',' order by content), '')"
                         "  from gp_segment_configuration;")
    if rc != 0:
        print("  topology check: SKIPPED -- could not read gp_segment_configuration (%s)"
              % (err or out or "no output"))
        return 0

    if out != want:
        print("  topology check: FAILED -- the coordinator does not describe this DR cluster")
        print("    expected (from the topology file): %s" % want)
        print("    serving  (from %s):                %s"
              % (_topology_source(port) or "the active store", out or "<none>"))
        print("    this replica would dispatch to the wrong cluster.")
        return 1

    print("  topology check: coordinator serves %d DR-local entr%s from %s"
          % (len(rows), "y" if len(rows) == 1 else "ies",
             _topology_source(port) or "the active store"))
    return 0


def _topology_source(port):
    """Which provider the node is actually running, or None if it will not say."""
    rc, out, err = _psql(port, "show gp_topology_source;")
    return out if rc == 0 and out else None


def _backup_label_start_file(datadir):
    """Return the START WAL segment file name from a datadir's backup_label, or None."""
    try:
        with open(os.path.join(datadir, "backup_label")) as f:
            for line in f:
                if line.startswith("START WAL LOCATION"):
                    # START WAL LOCATION: 0/2000028 (file 000000010000000000000002)
                    if "(file " in line:
                        return line.split("(file ", 1)[1].split(")", 1)[0].strip()
    except OSError:
        pass
    return None


def _archive_dir(wal_archive, content):
    return os.path.join(wal_archive, "seg%d" % content)


def _read_postmaster_pid(datadir):
    """First line of datadir/postmaster.pid as int, or None if absent/garbage."""
    try:
        with open(os.path.join(datadir, "postmaster.pid")) as f:
            return int(f.readline().strip())
    except (OSError, ValueError):
        return None


def _pid_alive(pid):
    """True iff process pid currently exists (EPERM counts as alive)."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _stop_node(datadir):
    """Stop any postmaster running in datadir so it can be safely overwritten.

    Used by create-replica --force to rebuild a DR cluster that is currently up
    -- typically one that has just been 'promote'd to online read-write, whose
    live postmaster (and its postmaster.pid) would otherwise block the rebuild.
    Returns True once no live postmaster holds the datadir; False if one remains.
    """
    pidfile = os.path.join(datadir, "postmaster.pid")
    if not os.path.exists(pidfile):
        return True
    print("  --force: stopping the node running in %s before rebuild" % datadir)
    _run(["pg_ctl", "-D", datadir, "-m", "fast", "-w", "stop"])
    if not os.path.exists(pidfile):
        return True
    # pg_ctl left the pidfile: either the stop failed or it was already stale.
    if _pid_alive(_read_postmaster_pid(datadir)):
        return False
    try:
        os.remove(pidfile)   # stale pidfile from a crashed/killed node
    except OSError:
        pass
    return True


def cmd_create_replica(topology, basebackup_dir, wal_archive, restore_command=None,
                       pause_at=None, no_start=False, force=False):
    rows = _parse_topology(topology)
    if restore_command is None:
        restore_command = "cp %s/seg%%c/%%f %%p" % wal_archive
    # gg_topology is a src/bin program, so it is on PATH or in $GPHOME/bin; the
    # third candidate only helps someone running both out of a source tree.
    here = os.path.dirname(os.path.abspath(__file__))
    topo_prog = next((c for c in (
        shutil.which("gg_topology"),
        os.path.join(os.environ.get("GPHOME", ""), "bin", "gg_topology"),
        os.path.join(here, "gg_topology"),
    ) if c and os.path.exists(c)), None)
    if not topo_prog:
        sys.exit("ggdr create-replica: cannot find gg_topology "
                 "(looked on PATH, in $GPHOME/bin, and next to ggdr)")
    print("ggdr create-replica: building a DR replica for %d instance(s) from %s"
          % (len(rows), basebackup_dir))

    # --- 1. safety / idempotence ---
    #     Without --force we refuse on a running node (postmaster.pid) or any
    #     non-empty datadir.  With --force we first STOP any node running here --
    #     e.g. a DR cluster just 'promote'd to online read-write -- so its live
    #     postmaster (and postmaster.pid) can be rebuilt instead of blocking us.
    for r in rows:
        dd = r["datadir"]
        has_pid = os.path.exists(os.path.join(dd, "postmaster.pid"))
        if not force:
            if has_pid:
                sys.exit("ggdr create-replica: %s has a postmaster.pid (running?); "
                         "stop the cluster or pass --force to stop+overwrite it." % dd)
            if os.path.exists(dd) and os.listdir(dd):
                sys.exit("ggdr create-replica: %s is non-empty; use --force to overwrite." % dd)
            continue
        if has_pid and not _stop_node(dd):
            sys.exit("ggdr create-replica: a live postmaster still holds %s after "
                     "'pg_ctl stop'; refusing to overwrite it." % dd)

    # --- 2. restore each instance's base backup ---
    for r in rows:
        dd, c = r["datadir"], r["content"]
        src = os.path.join(basebackup_dir, "seg%d" % c)
        if not os.path.isdir(src):
            sys.exit("ggdr create-replica: base backup %s not found" % src)
        _run(["rm", "-rf", dd]); os.makedirs(os.path.dirname(dd), exist_ok=True)
        rc, out, err = _run(["cp", "-a", src, dd])
        if rc != 0:
            sys.exit("ggdr create-replica: restore of content %d failed: %s" % (c, err))
        os.chmod(dd, 0o700)
        if not os.path.exists(os.path.join(dd, "backup_label")):
            sys.exit("ggdr create-replica: content %d base backup has no backup_label "
                     "(was it taken with pg_basebackup --target-gp-dbid?)" % c)
        print("  restored content %d -> %s" % (c, dd))

    # --- 3. archive-completeness gate: the WAL to reach consistency
    #     ([REDO..backup end]) must be in the archive.
    #
    #     This used to be a corruption gate -- on an archive miss, recovery would
    #     replay the topology seed's forked WAL and permanently fork the timeline.
    #     There is no seed and no forked WAL any more, so what is left is a
    #     usability gate: without those segments the node starts and then waits
    #     forever for a file that is not coming, which is a much worse symptom to
    #     debug than a refusal here. ---
    for r in rows:
        c, dd = r["content"], r["datadir"]
        adir = _archive_dir(wal_archive, c)
        start_file = _backup_label_start_file(dd)
        if not os.path.isdir(adir) or not os.listdir(adir):
            sys.exit("ggdr create-replica: WAL archive %s is missing/empty; refusing (fail-closed)." % adir)
        if start_file and not os.path.exists(os.path.join(adir, start_file)):
            sys.exit("ggdr create-replica: archive %s lacks the backup START WAL segment %s; "
                     "refusing (fail-closed)." % (adir, start_file))
        print("  archive gate OK for content %d (start=%s)" % (c, start_file or "?"))

    # --- 4. write the DR-local cluster topology into EVERY node's own store ---
    #
    #     The base backup carried production's $PGDATA/gp_topology into every data
    #     directory (basebackup.c excludes only the in-progress temp file, on the
    #     stated grounds that a node needing a different topology has it
    #     overwritten after the copy).  This is that overwrite, and it has to
    #     happen before any node starts: a coordinator armed with
    #     gp_topology_source=file refuses to start in dispatch mode on a store that
    #     has never been written, which is the right way round -- a replica that
    #     cannot describe itself must not come up describing production.
    #
    #     Every node gets the file, not just the coordinator.  Only the
    #     coordinator's copy is read while the replica serves reads, but a segment
    #     left holding production's entries would start describing the wrong
    #     cluster the moment this replica is promoted and its FTS begins writing
    #     the store.  gp_topology_source is also exempt from the QD/QE GUC-sync
    #     check, so a half-armed cluster would come up silently; writing and arming
    #     in one loop is what keeps the two from drifting.
    store = _topology_store_lines(rows)
    for r in rows:
        dd, c = r["datadir"], r["content"]
        rc, out, err = _run([topo_prog, "write", "-D", dd, "-"], stdin=store)
        if rc != 0:
            sys.exit("ggdr create-replica: could not write the topology store for "
                     "content %d (%s): %s" % (c, dd, (err or out).strip()))
        print("  topology store written for content %d: %s" % (c, (out or "").strip()))

    # --- 5. arm DR mode on every node ---
    for r in rows:
        dd = r["datadir"]
        open(os.path.join(dd, "postgresql.auto.conf"), "w").close()   # drop production sync-rep settings
        with open(os.path.join(dd, "postgresql.conf"), "a") as f:
            f.write("\n# --- GREENGAGE DR REPLICA (ggdr create-replica) ---\n")
            # The topology this node just had written, rather than the catalog
            # production's WAL keeps overwriting.  PGC_POSTMASTER, so it belongs in
            # postgresql.conf and survives gpstart/gpstop, unlike a pg_ctl -o flag.
            f.write("gp_topology_source = file\n")
            f.write("hot_standby = on\n")
            f.write("restore_command = '%s'\n" % restore_command)
            f.write("recovery_target_timeline = 'current'\n")
            # Reads are served from the image frozen at the restore point, so a
            # reader's xmin sits well behind replay and conflicts are the norm,
            # not the exception. The 30s default would add 30s to every advance
            # that hits one; 0 cancels the reader at once, which is the agreed
            # policy (the right answer or none). Note -1 is not the opposite
            # extreme but a trap: it blocks the startup process inside redo, so
            # replay stops altogether.
            f.write("max_standby_archive_delay = 0\n")
            f.write("max_standby_streaming_delay = 0\n")
            if pause_at:
                f.write("gp_pause_on_restore_point_replay = '%s'\n" % pause_at)
        open(os.path.join(dd, "standby.signal"), "w").close()
    print("  armed DR mode (gp_topology_source=file + hot_standby + restore_command"
          " + standby.signal)")
    if not pause_at:
        # A replica serves from the image it freezes at a restore point. With no
        # pause target it replays to the end of the archive without ever stopping
        # at one, so it never has anything to serve and every query is refused.
        print("  WARNING: no --pause-at, so this replica will not stop at a restore point")
        print("           and will refuse reads until one is armed. Set")
        print("           gp_pause_on_restore_point_replay on every node and reload.")
    # gpstart/gpstop resolve the coordinator datadir from $COORDINATOR_DATA_DIRECTORY
    # (or the legacy $MASTER_DATA_DIRECTORY); the DR cluster is not built by gpdemo, so
    # nothing exports it -- tell the operator how to manage this cluster with them.
    print("  to manage this cluster with gpstart/gpstop, set:")
    print("    export COORDINATOR_DATA_DIRECTORY=%s"
          % next(r["datadir"] for r in rows if r["content"] == -1))

    if no_start:
        print("ggdr create-replica: DONE (armed, not started; --no-start).")
        return 0

    # --- 6. start each node in recovery + poll for liveness ---
    for r in rows:
        dd, c, port = r["datadir"], r["content"], r["port"]
        role = "dispatch" if c == -1 else "execute"
        _run(["pg_ctl", "-D", dd, "-l", os.path.join(dd, "startup.log"),
              "-W", "-o", "-c gp_role=%s" % role, "start"])
        print("  started content %d (port %d, gp_role=%s) in recovery" % (c, port, role))
    ok = 0
    for r in rows:
        port = r["port"]
        for _ in range(80):
            rc, out, err = _psql(port, "select 1;")
            if out == "1":
                ok += 1; break
            time.sleep(3)
    # --- 7. post-build check: the running replica describes THIS cluster ---
    topo_rc = _check_topology(rows) if ok == len(rows) else 0
    print("ggdr create-replica: DONE -- %d/%d node(s) live in recovery." % (ok, len(rows)))
    return 0 if (ok == len(rows) and topo_rc == 0) else 1


def main():
    ap = argparse.ArgumentParser(
        prog="ggdr",
        description="Control a Greengage DR read-replica's recovery (switch / pause / stat / promote).")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p_switch = sub.add_parser("switch", help="pause every node at <restore_point> (stop-and-go)")
    p_switch.add_argument("restore_point", help="the restore point to pause the whole cluster at")
    sub.add_parser("pause", help="immediately pause replay on every node (not a consistent cut)")
    sub.add_parser("stat", help="print recovery statistics")
    p_prom = sub.add_parser("promote", help="promote the DR cluster to a normal online read-write cluster")
    p_prom.add_argument("--at", metavar="RP", help="require the consistent cut to equal this restore point")
    p_prom.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    p_prom.add_argument("--timeout", type=int, default=300, help="seconds to wait per phase (default 300)")
    p_cr = sub.add_parser("create-replica", help="build a DR replica from per-instance base backups")
    p_cr.add_argument("--topology", required=True, metavar="TSV",
                      help="dr_topology.tsv (dbid content role prefrole mode status port host addr datadir)")
    p_cr.add_argument("--basebackup-dir", required=True, metavar="DIR",
                      help="directory containing seg<content>/ base backups (pg_basebackup --target-gp-dbid)")
    p_cr.add_argument("--wal-archive", required=True, metavar="DIR",
                      help="per-content WAL archive root (seg<content>/ segments)")
    p_cr.add_argument("--restore-command", metavar="CMD",
                      help="restore_command (default: cp <wal-archive>/seg%%c/%%f %%p)")
    p_cr.add_argument("--pause-at", metavar="RP", help="arm gp_pause_on_restore_point_replay at this restore point")
    p_cr.add_argument("--no-start", action="store_true", help="arm the replica but do not start it")
    p_cr.add_argument("--force", action="store_true", help="overwrite non-empty data directories")
    args = ap.parse_args()
    if args.cmd == "switch":
        return cmd_switch(args.restore_point)
    if args.cmd == "pause":
        return cmd_pause()
    if args.cmd == "stat":
        return cmd_stat()
    if args.cmd == "promote":
        return cmd_promote(at=args.at,
                           assume_yes=args.yes, timeout=args.timeout)
    if args.cmd == "create-replica":
        return cmd_create_replica(topology=args.topology, basebackup_dir=args.basebackup_dir,
                                  wal_archive=args.wal_archive, restore_command=args.restore_command,
                                  pause_at=args.pause_at,
                                  no_start=args.no_start, force=args.force)
    return 2


if __name__ == "__main__":
    sys.exit(main())
