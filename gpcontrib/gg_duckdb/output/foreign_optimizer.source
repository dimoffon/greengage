-- pushed quals show in the DuckDB query; a function DuckDB does not carry stays a Filter
SET gg_duckdb.mode = off;
EXPLAIN (COSTS OFF, VERBOSE) SELECT id FROM parts WHERE k = 3 AND upper(v) = 'V3';
                                                                       QUERY PLAN                                                                        
---------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Output: id
   ->  Foreign Scan on public.parts
         Output: id
         Filter: (upper(parts.v) = 'V3'::text)
         DuckDB reader: parquet @abs_srcdir@/data/parts_*.parquet
         DuckDB SQL: SELECT * FROM (SELECT CAST("id" AS BIGINT) AS c1, CAST("k" AS BIGINT) AS c2, CAST("v" AS VARCHAR) AS c3 FROM __GG_NATIVE_0__) AS n0 WHERE ((n0.c2) = (CAST($1 AS INTEGER)))
 Optimizer: GPORCA
 Settings: effective_cache_size = '512MB'
(9 rows)

-- the reader inlined into a region: no leaf, no conversion on the way in
SET gg_duckdb.mode = force;
SET gg_duckdb.explain_decisions = on;
SET optimizer_force_multistage_agg = on; SET gp_eager_two_phase_agg = on;
EXPLAIN (COSTS OFF, VERBOSE) SELECT k, count(*), sum(amt) FROM parts WHERE flag GROUP BY k;
NOTICE:  gg_duckdb: Agg (plan node 1): region [Agg over 1 leaf]: SELECT * FROM (SELECT n1.c1 AS c1, CAST(sum(n1.c2) AS BIGINT) AS c2, CAST(sum(struct_extract(n1.c3, 's')) AS DECIMAL(38,2)) AS c3 FROM (SELECT * FROM gg_leaf(0)) AS n1 GROUP BY n1.c1) AS n2
NOTICE:  gg_duckdb: Agg (plan node 4): region [Agg over 0 leaves and 1 native reader]: SELECT * FROM (SELECT n1.c1 AS c1, CAST(count(*) AS BIGINT) AS c2, struct_pack(s := CAST(sum(n1.c2) AS DECIMAL(38,2)), n := count(n1.c2)) AS c3 FROM (SELECT n0.c2 AS c1, n0.c4 AS c2 FROM (SELECT * FROM (SELECT CAST("k" AS BIGINT) AS c2, CAST("amt" AS DECIMAL(12,2)) AS c4, CAST("flag" AS BOOLEAN) AS c7 FROM __GG_NATIVE_0__) AS n0 WHERE n0.c7) AS n0) AS n1 GROUP BY n1.c1) AS n2
                                                                                                                                                                                                         QUERY PLAN                                                                                                                                                                                                         
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Output: gg_duckdb_region.k, gg_duckdb_region.count, gg_duckdb_region.sum
   ->  Custom Scan (GGDuckDBRegion)
         Output: gg_duckdb_region.k, gg_duckdb_region.count, gg_duckdb_region.sum
         DuckDB: Agg over 1 leaf
         DuckDB SQL: SELECT * FROM (SELECT n1.c1 AS c1, CAST(sum(n1.c2) AS BIGINT) AS c2, CAST(sum(struct_extract(n1.c3, 's')) AS DECIMAL(38,2)) AS c3 FROM (SELECT * FROM gg_leaf(0)) AS n1 GROUP BY n1.c1) AS n2
         ->  Redistribute Motion 3:3  (slice2; segments: 3)
               Output: gg_duckdb_region_1.k, (PARTIAL count()), (PARTIAL sum(gg_duckdb_region_1.amt))
               Hash Key: gg_duckdb_region_1.k
               ->  Custom Scan (GGDuckDBRegion)
                     Output: gg_duckdb_region_1.k, (PARTIAL count()), (PARTIAL sum(gg_duckdb_region_1.amt))
                     DuckDB: Agg over 0 leaves and 1 native reader
                     DuckDB readers: parts (parquet @abs_srcdir@/data/parts_*.parquet)
                     DuckDB SQL: SELECT * FROM (SELECT n1.c1 AS c1, CAST(count(*) AS BIGINT) AS c2, struct_pack(s := CAST(sum(n1.c2) AS DECIMAL(38,2)), n := count(n1.c2)) AS c3 FROM (SELECT n0.c2 AS c1, n0.c4 AS c2 FROM (SELECT * FROM (SELECT CAST("k" AS BIGINT) AS c2, CAST("amt" AS DECIMAL(12,2)) AS c4, CAST("flag" AS BOOLEAN) AS c7 FROM __GG_NATIVE_0__) AS n0 WHERE n0.c7) AS n0) AS n1 GROUP BY n1.c1) AS n2
 Optimizer: GPORCA
 Settings: effective_cache_size = '512MB', gp_eager_two_phase_agg = 'on', optimizer_force_multistage_agg = 'on'
(16 rows)

RESET optimizer_force_multistage_agg; RESET gp_eager_two_phase_agg;
SET gg_duckdb.explain_decisions = off;
SET gg_duckdb.mode = off;
-- a scan rescanned by a correlated subquery
