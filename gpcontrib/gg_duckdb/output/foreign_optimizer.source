-- IMPORT FOREIGN SCHEMA: one table per file, one per subdirectory
CREATE SCHEMA imported;
IMPORT FOREIGN SCHEMA "@abs_srcdir@/data" FROM SERVER duck INTO imported;
SELECT foreign_table_name FROM information_schema.foreign_tables WHERE foreign_table_schema = 'imported' ORDER BY 1;
