-- locations outside gg_duckdb.data_directories are refused
CREATE FOREIGN TABLE outside (id int) SERVER duck OPTIONS (location '/etc/passwd', format 'csv');
ERROR:  gg_duckdb: location "/etc/passwd" is outside gg_duckdb.data_directories  (seg2 127.0.1.1:9004 pid=1881217)
HINT:  Set gg_duckdb.data_directories to the directories DuckDB may read on every node.
