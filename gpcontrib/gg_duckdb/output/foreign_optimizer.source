RESET gg_duckdb.mode;
DROP FUNCTION f_check(text, text);
DROP SCHEMA imported CASCADE;
NOTICE:  drop cascades to 6 other objects
DETAIL:  drop cascades to foreign table imported.parts_0
drop cascades to foreign table imported.parts_1
drop cascades to foreign table imported.parts_2
drop cascades to foreign table imported.parts_3
drop cascades to foreign table imported.parts_4
drop cascades to foreign table imported.parts_5
DROP FOREIGN TABLE parts; DROP FOREIGN TABLE items; DROP FOREIGN TABLE tags; DROP FOREIGN TABLE one;
DROP SERVER duck;
DROP TABLE ref_parts;
