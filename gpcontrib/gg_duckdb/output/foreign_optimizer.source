               'SELECT k, count(*) AS n, sum(amt) AS sa, min(ts) AS mt, max(d) AS md, bool_and(flag) AS bf, sum(s) AS ss, sum(n4) AS s4, count(nullable) AS cn FROM ref_parts GROUP BY k');
