-- the same rows generated in PostgreSQL, as the reference
CREATE TABLE ref_parts AS
SELECT i::bigint AS id, (i % 7)::bigint AS k, 'v' || i AS v, (i * 1.25)::numeric(12,2) AS amt,
       (date '2024-01-01' + (i % 100))::timestamp AS ts, date '2024-01-01' + (i % 100) AS d,
       i % 3 = 0 AS flag, i::smallint AS s, i::int AS n4, i::float8 / 4 AS f8,
       CASE WHEN i % 13 = 0 THEN NULL ELSE i::bigint END AS nullable
FROM generate_series(0, 5999) i DISTRIBUTED BY (id);
CREATE SERVER duck FOREIGN DATA WRAPPER gg_duckdb;
CREATE FOREIGN TABLE parts (id bigint, k bigint, v text, amt numeric(12,2), ts timestamp, d date,
                            flag boolean, s smallint, n4 integer, f8 float8, nullable bigint)
  SERVER duck OPTIONS (location '@abs_srcdir@/data/parts_*.parquet');
CREATE FOREIGN TABLE items (id bigint, name text, price numeric(8,2))
  SERVER duck OPTIONS (location '@abs_srcdir@/data/items.csv', format 'csv', header 'true');
CREATE FOREIGN TABLE tags (id bigint, tag text)
  SERVER duck OPTIONS (location '@abs_srcdir@/data/tags.json', format 'json');
-- every file is read by exactly one segment
SELECT count(*) AS files, count(DISTINCT file) AS distinct_files, count(DISTINCT segment) AS segments
FROM gg_duckdb.foreign_files('parts');
 files | distinct_files | segments 
-------+----------------+----------
     6 |              6 |        3
(1 row)

SELECT count(*) FROM parts;
 count 
-------
  6000
(1 row)

-- the files equal the reference, through the foreign scan and through regions
CREATE OR REPLACE FUNCTION f_check(q text, r text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE missing bigint; extra bigint;
BEGIN
  EXECUTE 'CREATE TEMP TABLE f_duck AS ' || q;
  EXECUTE 'CREATE TEMP TABLE f_base AS ' || r;
  EXECUTE 'SELECT count(*) FROM (TABLE f_base EXCEPT ALL TABLE f_duck) x' INTO missing;
  EXECUTE 'SELECT count(*) FROM (TABLE f_duck EXCEPT ALL TABLE f_base) x' INTO extra;
  DROP TABLE f_base; DROP TABLE f_duck;
  RETURN missing || ' | ' || extra;
END $$;
SET gg_duckdb.mode = off;
SELECT f_check('SELECT * FROM parts', 'SELECT * FROM ref_parts');
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
 f_check 
---------
 0 | 0
(1 row)

