-- division by zero is an error in both executors
SET gg_duckdb.mode = force;
SELECT id, sum(qty / (id - 7)) FROM d_orders WHERE id < 10 GROUP BY id ORDER BY id;
ERROR:  gg_duckdb: region query failed: Invalid Input Error: division by zero  (seg0 slice1 127.0.1.1:9002 pid=1153040)
SET gg_duckdb.mode = off;
SELECT id, sum(qty / (id - 7)) FROM d_orders WHERE id < 10 GROUP BY id ORDER BY id;
ERROR:  division by zero  (seg0 slice1 127.0.1.1:9002 pid=1153040)
