-- M4: DuckDB(t1 t2 ...) and NoDuckDB(t1 t2 ...) hints through pg_hint_plan.
-- A hint forces or forbids regions by the aliases of their scan leaves; it
-- beats the cost gate, never makes an ineligible subtree eligible, loses to
-- NoDuckDB, and is ignored under gg_duckdb.mode = off.
LOAD 'pg_hint_plan';
CREATE EXTENSION IF NOT EXISTS gg_duckdb;
NOTICE:  extension "gg_duckdb" already exists, skipping
CREATE TABLE h_a (id int, k int, v text) DISTRIBUTED BY (k);
CREATE TABLE h_b (id int, k int, w int8) DISTRIBUTED BY (k);
INSERT INTO h_a SELECT i, i % 500, 'v' || (i % 37) FROM generate_series(1, 20000) i;
INSERT INTO h_b SELECT i, i % 700, i::int8 * 3 FROM generate_series(1, 20000) i;
ANALYZE h_a; ANALYZE h_b;
-- a hint keyword ORCA does not know must not make it fall back
SET optimizer_trace_fallback = on;
SET gg_duckdb.mode = auto;
SET gg_duckdb.explain_decisions = on;
-- the gate is not the subject here: a row floor keeps it out of the way
SET gg_duckdb.min_rows = 100000;
-- without a hint the gate declines this small input
EXPLAIN (COSTS OFF)
SELECT a.k, count(*), sum(b.w) FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  gg_duckdb: Agg (plan node 1): estimated input rows below gg_duckdb.min_rows
NOTICE:  gg_duckdb: HashJoin (plan node 2): estimated input rows below gg_duckdb.min_rows
                QUERY PLAN                 
-------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  HashAggregate
         Group Key: a.k
         ->  Hash Join
               Hash Cond: (b.k = a.k)
               ->  Seq Scan on h_b b
               ->  Hash
                     ->  Seq Scan on h_a a
 Optimizer: GPORCA
(9 rows)

-- DuckDB(a b) forces the maximal eligible region covering both relations
/*+ DuckDB(a b) */
EXPLAIN (COSTS OFF)
SELECT a.k, count(*), sum(b.w) FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  gg_duckdb: Agg (plan node 1): region [Join Agg over 2 leaves] forced by a DuckDB hint: SELECT * FROM (SELECT n3.c1 AS c1, CAST(count(*) AS BIGINT) AS c2, CAST(sum(n3.c2) AS DECIMAL(38,0)) AS c3 FROM (SELECT n2.c1 AS c1, n1.c2 AS c2 FROM (SELECT * FROM gg_leaf(0)) AS n1 JOIN (SELECT * FROM gg_leaf(1)) AS n2 ON ((n1.c1) = (n2.c1))) AS n3 GROUP BY n3.c1) AS n4
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Custom Scan (GGDuckDBRegion)
         DuckDB: Join Agg over 2 leaves
         ->  Seq Scan on h_b b
         ->  Seq Scan on h_a a
 Optimizer: GPORCA
(6 rows)

-- naming one relation is enough: the region rooted at the Agg covers it
/*+ DuckDB(b) */
EXPLAIN (COSTS OFF)
SELECT a.k, count(*), sum(b.w) FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  gg_duckdb: Agg (plan node 1): region [Join Agg over 2 leaves] forced by a DuckDB hint: SELECT * FROM (SELECT n3.c1 AS c1, CAST(count(*) AS BIGINT) AS c2, CAST(sum(n3.c2) AS DECIMAL(38,0)) AS c3 FROM (SELECT n2.c1 AS c1, n1.c2 AS c2 FROM (SELECT * FROM gg_leaf(0)) AS n1 JOIN (SELECT * FROM gg_leaf(1)) AS n2 ON ((n1.c1) = (n2.c1))) AS n3 GROUP BY n3.c1) AS n4
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Custom Scan (GGDuckDBRegion)
         DuckDB: Join Agg over 2 leaves
         ->  Seq Scan on h_b b
         ->  Seq Scan on h_a a
 Optimizer: GPORCA
(6 rows)

-- DuckDB() addresses the whole query
/*+ DuckDB() */
EXPLAIN (COSTS OFF)
SELECT a.k, count(*), sum(b.w) FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  gg_duckdb: Agg (plan node 1): region [Join Agg over 2 leaves] forced by a DuckDB hint: SELECT * FROM (SELECT n3.c1 AS c1, CAST(count(*) AS BIGINT) AS c2, CAST(sum(n3.c2) AS DECIMAL(38,0)) AS c3 FROM (SELECT n2.c1 AS c1, n1.c2 AS c2 FROM (SELECT * FROM gg_leaf(0)) AS n1 JOIN (SELECT * FROM gg_leaf(1)) AS n2 ON ((n1.c1) = (n2.c1))) AS n3 GROUP BY n3.c1) AS n4
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Custom Scan (GGDuckDBRegion)
         DuckDB: Join Agg over 2 leaves
         ->  Seq Scan on h_b b
         ->  Seq Scan on h_a a
 Optimizer: GPORCA
(6 rows)

-- NoDuckDB wins over DuckDB and over gg_duckdb.mode = force
SET gg_duckdb.mode = force;
/*+ DuckDB(a b) NoDuckDB(b) */
EXPLAIN (COSTS OFF)
SELECT a.k, count(*), sum(b.w) FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  gg_duckdb: Agg (plan node 1): forbidden by a NoDuckDB hint
NOTICE:  gg_duckdb: HashJoin (plan node 2): forbidden by a NoDuckDB hint
NOTICE:  gg_duckdb: hint DuckDB(a b) could not be honoured: no eligible DuckDB region covers these relations
                QUERY PLAN                 
-------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  HashAggregate
         Group Key: a.k
         ->  Hash Join
               Hash Cond: (b.k = a.k)
               ->  Seq Scan on h_b b
               ->  Hash
                     ->  Seq Scan on h_a a
 Optimizer: GPORCA
(9 rows)

/*+ NoDuckDB() */
EXPLAIN (COSTS OFF)
SELECT a.k, count(*), sum(b.w) FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  gg_duckdb: Agg (plan node 1): forbidden by a NoDuckDB hint
NOTICE:  gg_duckdb: HashJoin (plan node 2): forbidden by a NoDuckDB hint
                QUERY PLAN                 
-------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  HashAggregate
         Group Key: a.k
         ->  Hash Join
               Hash Cond: (b.k = a.k)
               ->  Seq Scan on h_b b
               ->  Hash
                     ->  Seq Scan on h_a a
 Optimizer: GPORCA
(9 rows)

SET gg_duckdb.mode = auto;
-- a hint cannot make an ineligible subtree eligible: upper() is not carried,
-- and a bare scan has nothing for DuckDB to do
/*+ DuckDB(a) */
EXPLAIN (COSTS OFF)
SELECT upper(v), count(*) FROM h_a a GROUP BY 1;
NOTICE:  gg_duckdb: Agg (plan node 1): estimated input rows below gg_duckdb.min_rows
NOTICE:  gg_duckdb: Agg (plan node 4): region [Agg over 1 leaf] forced by a DuckDB hint: SELECT * FROM (SELECT n1.c1 AS c1, CAST(count(*) AS BIGINT) AS c2 FROM (SELECT * FROM gg_leaf(0)) AS n1 GROUP BY n1.c1) AS n2
                         QUERY PLAN                         
------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Finalize HashAggregate
         Group Key: gg_duckdb_region.upper
         ->  Redistribute Motion 3:3  (slice2; segments: 3)
               Hash Key: gg_duckdb_region.upper
               ->  Custom Scan (GGDuckDBRegion)
                     DuckDB: Agg over 1 leaf
                     ->  Seq Scan on h_a a
 Optimizer: GPORCA
(9 rows)

/*+ DuckDB(a) */
EXPLAIN (COSTS OFF)
SELECT * FROM h_a a WHERE id < 10;
NOTICE:  gg_duckdb: hint DuckDB(a) could not be honoured: no eligible DuckDB region covers these relations
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on h_a a
         Filter: (id < 10)
 Optimizer: GPORCA
(4 rows)

-- an alias the query does not have
/*+ DuckDB(zzz) */
EXPLAIN (COSTS OFF)
SELECT k, count(*) FROM h_a a GROUP BY k;
NOTICE:  gg_duckdb: hint DuckDB(zzz) could not be honoured: "zzz" is not a relation of the query
NOTICE:  gg_duckdb: Agg (plan node 1): estimated input rows below gg_duckdb.min_rows
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  HashAggregate
         Group Key: k
         ->  Seq Scan on h_a a
 Optimizer: GPORCA
(5 rows)

-- gg_duckdb.strict makes an unhonoured hint an error
SET gg_duckdb.strict = on;
/*+ DuckDB(zzz) */
EXPLAIN (COSTS OFF)
SELECT k, count(*) FROM h_a a GROUP BY k;
ERROR:  gg_duckdb: hint DuckDB(zzz) could not be honoured: "zzz" is not a relation of the query
/*+ DuckDB(a) */
EXPLAIN (COSTS OFF)
SELECT * FROM h_a a WHERE id < 10;
ERROR:  gg_duckdb: hint DuckDB(a) could not be honoured: no eligible DuckDB region covers these relations
RESET gg_duckdb.strict;
-- gg_duckdb.mode = off ignores hints
SET gg_duckdb.mode = off;
/*+ DuckDB(a b) */
EXPLAIN (COSTS OFF)
SELECT a.k, count(*), sum(b.w) FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
                QUERY PLAN                 
-------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  HashAggregate
         Group Key: a.k
         ->  Hash Join
               Hash Cond: (b.k = a.k)
               ->  Seq Scan on h_b b
               ->  Hash
                     ->  Seq Scan on h_a a
 Optimizer: GPORCA
(9 rows)

SET gg_duckdb.explain_decisions = off;
-- the forced region returns what the standard executor returns
SET gg_duckdb.mode = auto;
CREATE TEMP TABLE h_base AS
SELECT a.k, count(*) AS n, sum(b.w) AS sw FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
/*+ DuckDB(a b) */
CREATE TEMP TABLE h_duck AS
SELECT a.k, count(*) AS n, sum(b.w) AS sw FROM h_a a JOIN h_b b ON a.k = b.k GROUP BY a.k;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
SELECT count(*) AS missing FROM (TABLE h_base EXCEPT ALL TABLE h_duck) x;
 missing 
---------
       0
(1 row)

SELECT count(*) AS extra FROM (TABLE h_duck EXCEPT ALL TABLE h_base) x;
 extra 
-------
     0
(1 row)

DROP TABLE h_base; DROP TABLE h_duck;
RESET gg_duckdb.mode;
RESET optimizer_trace_fallback;
DROP TABLE h_a; DROP TABLE h_b;
RESET gg_duckdb.min_rows;
