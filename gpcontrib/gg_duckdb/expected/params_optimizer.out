SET plan_cache_mode = force_generic_plan;
PREPARE p_join(int) AS SELECT a.k, count(*) AS n FROM p_a a JOIN p_b b ON a.k = b.k AND a.id + b.id > $1 GROUP BY a.k ORDER BY a.k LIMIT 3;
SET gg_duckdb.explain_decisions = on;
EXPLAIN (COSTS OFF) EXECUTE p_join(20000);
NOTICE:  gg_duckdb: Limit (plan node 2): region [Limit Sort Join Agg over 2 leaves]: SELECT * FROM (SELECT n3.c1 AS c1, CAST(count(*) AS BIGINT) AS c2 FROM (SELECT n1.c2 AS c1 FROM (SELECT * FROM gg_leaf(0)) AS n1 JOIN (SELECT * FROM gg_leaf(1)) AS n2 ON ((n1.c2) = (n2.c2)) AND ((CAST((n1.c1) + (n2.c1) AS INTEGER)) > (CAST($1 AS INTEGER)))) AS n3 GROUP BY n3.c1) AS n4 ORDER BY c1 ASC NULLS LAST LIMIT 3 OFFSET 0
                       QUERY PLAN                        
---------------------------------------------------------
 Limit
   ->  Gather Motion 3:1  (slice1; segments: 3)
         Merge Key: gg_duckdb_region.k
         ->  Custom Scan (GGDuckDBRegion)
               DuckDB: Limit Sort Join Agg over 2 leaves
               ->  Seq Scan on p_a a
               ->  Seq Scan on p_b b
 Optimizer: GPORCA
(8 rows)

SET gg_duckdb.explain_decisions = off;
EXECUTE p_join(20000);
