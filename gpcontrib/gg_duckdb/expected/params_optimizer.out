-- M6: executor parameters inside regions (an InitPlan's result, a prepared
-- statement's argument, a PL/pgSQL variable) and the float-aggregate opt-in.
CREATE TABLE p_a (id int, k int, v text, f float8, n numeric(10,2)) DISTRIBUTED BY (k);
CREATE TABLE p_b (id int, k int) DISTRIBUTED BY (k);
INSERT INTO p_a SELECT i, i % 300, 'v' || (i % 17), i / 7.0, (i % 1000) / 4.0 FROM generate_series(1, 20000) i;
INSERT INTO p_b SELECT i, i % 300 FROM generate_series(1, 5000) i;
ANALYZE p_a; ANALYZE p_b;
CREATE OR REPLACE FUNCTION p_check(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE missing bigint; extra bigint;
BEGIN
  SET LOCAL gg_duckdb.mode = off;
  EXECUTE 'CREATE TEMP TABLE p_base AS ' || q;
  SET LOCAL gg_duckdb.mode = force;
  EXECUTE 'CREATE TEMP TABLE p_duck AS ' || q;
  SET LOCAL gg_duckdb.mode = off;
  EXECUTE 'SELECT count(*) FROM (TABLE p_base EXCEPT ALL TABLE p_duck) x' INTO missing;
  EXECUTE 'SELECT count(*) FROM (TABLE p_duck EXCEPT ALL TABLE p_base) x' INTO extra;
  DROP TABLE p_base; DROP TABLE p_duck;
  RETURN missing || ' | ' || extra;
END $$;
SET gg_duckdb.mode = force;
SET gg_duckdb.explain_decisions = on;
-- an InitPlan's result, evaluated on the coordinator and dispatched, is a $n
EXPLAIN (COSTS OFF, VERBOSE)
SELECT k, count(*) FROM p_a WHERE id > (SELECT max(id) - 3000 FROM p_b) GROUP BY k;
NOTICE:  gg_duckdb: Agg (plan node 1): region [Join Agg over 2 leaves]: SELECT * FROM (SELECT n3.c1 AS c1, CAST(count(*) AS BIGINT) AS c2 FROM (SELECT n2.c2 AS c1 FROM (SELECT * FROM gg_leaf(0)) AS n1 JOIN (SELECT * FROM gg_leaf(1)) AS n2 ON ((n2.c1) > (n1.c1))) AS n3 GROUP BY n3.c1) AS n4
NOTICE:  gg_duckdb: Agg (plan node 8): region [Agg over 1 leaf]: SELECT * FROM (SELECT CAST(max(n1.c1) AS INTEGER) AS c1 FROM (SELECT * FROM gg_leaf(0)) AS n1) AS n2
                                                                                                                   QUERY PLAN                                                                                                                   
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Output: gg_duckdb_region.k, (count())
   ->  Custom Scan (GGDuckDBRegion)
         Output: gg_duckdb_region.k, (count())
         DuckDB: Join Agg over 2 leaves
         DuckDB SQL: SELECT * FROM (SELECT n3.c1 AS c1, CAST(count(*) AS BIGINT) AS c2 FROM (SELECT n2.c2 AS c1 FROM (SELECT * FROM gg_leaf(0)) AS n1 JOIN (SELECT * FROM gg_leaf(1)) AS n2 ON ((n2.c1) > (n1.c1))) AS n3 GROUP BY n3.c1) AS n4
         ->  Broadcast Motion 1:3  (slice2)
               Output: ((max(gg_duckdb_region_1.id) - 3000))
               ->  Finalize Aggregate
                     Output: (max(gg_duckdb_region_1.id) - 3000)
                     ->  Gather Motion 3:1  (slice3; segments: 3)
                           Output: (PARTIAL max(gg_duckdb_region_1.id))
                           ->  Custom Scan (GGDuckDBRegion)
                                 Output: (PARTIAL max(gg_duckdb_region_1.id))
                                 DuckDB: Agg over 1 leaf
                                 DuckDB SQL: SELECT * FROM (SELECT CAST(max(n1.c1) AS INTEGER) AS c1 FROM (SELECT * FROM gg_leaf(0)) AS n1) AS n2
                                 ->  Seq Scan on public.p_b
                                       Output: p_b.id
         ->  Seq Scan on public.p_a
               Output: p_a.id, p_a.k
 Optimizer: GPORCA
 Settings: effective_cache_size = '512MB'
(22 rows)

SET gg_duckdb.explain_decisions = off;
SELECT p_check($q$ SELECT k, count(*) AS n, sum(n) AS sn FROM p_a WHERE id > (SELECT max(id) - 3000 FROM p_b) GROUP BY k $q$);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
 p_check 
---------
 0 | 0
(1 row)

SELECT p_check($q$ SELECT k, count(*) AS n FROM p_a WHERE v = (SELECT min(v) FROM p_a WHERE id < 10) AND id < (SELECT max(id) FROM p_b) GROUP BY k $q$);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
 p_check 
---------
 0 | 0
(1 row)

-- a prepared statement's arguments
PREPARE p_grp(int, text) AS SELECT k, count(*) AS n, sum(n) AS sn FROM p_a WHERE id > $1 AND v <> $2 GROUP BY k ORDER BY k LIMIT 5;
EXECUTE p_grp(15000, 'v3');
 k | n  |   sn    
---+----+---------
 0 | 15 | 1775.00
 1 | 16 | 1804.00
 2 | 16 | 1833.00
 3 | 16 | 1887.00
 4 | 16 | 1916.00
(5 rows)

EXECUTE p_grp(19990, 'v0');
  k  | n |   sn   
-----+---+--------
 191 | 1 | 247.75
 193 | 1 | 248.25
 194 | 1 | 248.50
 195 | 1 | 248.75
 196 | 1 | 249.00
(5 rows)

SET gg_duckdb.mode = off;
EXECUTE p_grp(15000, 'v3');
 k | n  |   sn    
---+----+---------
 0 | 15 | 1775.00
 1 | 16 | 1804.00
 2 | 16 | 1833.00
 3 | 16 | 1887.00
 4 | 16 | 1916.00
(5 rows)

EXECUTE p_grp(19990, 'v0');
  k  | n |   sn   
-----+---+--------
 191 | 1 | 247.75
 193 | 1 | 248.25
 194 | 1 | 248.50
 195 | 1 | 248.75
 196 | 1 | 249.00
(5 rows)

DEALLOCATE p_grp;
-- a PL/pgSQL variable inside a region
CREATE OR REPLACE FUNCTION p_count_above(threshold int) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE r bigint;
BEGIN
  SELECT count(*) INTO r FROM p_a a JOIN p_b b ON a.k = b.k WHERE a.id > threshold;
  RETURN r;
END $$;
SET gg_duckdb.mode = force;
SELECT p_count_above(10000), p_count_above(19000);
 p_count_above | p_count_above 
---------------+---------------
        166700 |         16700
(1 row)

SET gg_duckdb.mode = off;
SELECT p_count_above(10000), p_count_above(19000);
 p_count_above | p_count_above 
---------------+---------------
        166700 |         16700
(1 row)

-- parameters inside the region itself, not in a leaf's qual: a HAVING
-- clause, a join condition, and a generic plan's arguments
SET gg_duckdb.mode = force;
SET gg_duckdb.explain_decisions = on;
EXPLAIN (COSTS OFF, VERBOSE)
SELECT k, count(*) FROM p_a GROUP BY k HAVING count(*) > (SELECT count(*) FROM p_b) / 100;
NOTICE:  gg_duckdb: NestLoop (plan node 1): region [Join Agg over 2 leaves]: SELECT * FROM (SELECT n3.c3 AS c1, n3.c1 AS c2 FROM (SELECT * FROM gg_leaf(0)) AS n2 JOIN (SELECT CAST(count(*) AS BIGINT) AS c1, CAST(count(*) AS BIGINT) AS c2, n1.c1 AS c3 FROM (SELECT * FROM gg_leaf(1)) AS n1 GROUP BY n1.c1) AS n3 ON ((n3.c2) > (CAST((CASE WHEN (CAST($1 AS INTEGER)) = 0 THEN error('division by zero') ELSE (n2.c1) // (CAST($1 AS INTEGER)) END) AS BIGINT)))) AS n4
NOTICE:  gg_duckdb: Agg (plan node 7): region [Agg over 1 leaf]: SELECT * FROM (SELECT CAST(count(*) AS BIGINT) AS c1 FROM (SELECT * FROM gg_leaf(0)) AS n1) AS n2
                                                                                                                                                                                                      QUERY PLAN                                                                                                                                                                                                      
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Output: gg_duckdb_region.k, gg_duckdb_region.count
   ->  Custom Scan (GGDuckDBRegion)
         Output: gg_duckdb_region.k, gg_duckdb_region.count
         DuckDB: Join Agg over 2 leaves
         DuckDB SQL: SELECT * FROM (SELECT n3.c3 AS c1, n3.c1 AS c2 FROM (SELECT * FROM gg_leaf(0)) AS n2 JOIN (SELECT CAST(count(*) AS BIGINT) AS c1, CAST(count(*) AS BIGINT) AS c2, n1.c1 AS c3 FROM (SELECT * FROM gg_leaf(1)) AS n1 GROUP BY n1.c1) AS n3 ON ((n3.c2) > (CAST((CASE WHEN (CAST($1 AS INTEGER)) = 0 THEN error('division by zero') ELSE (n2.c1) // (CAST($1 AS INTEGER)) END) AS BIGINT)))) AS n4
         ->  Broadcast Motion 1:3  (slice2)
               Output: (count())
               ->  Finalize Aggregate
                     Output: count()
                     ->  Gather Motion 3:1  (slice3; segments: 3)
                           Output: (PARTIAL count())
                           ->  Custom Scan (GGDuckDBRegion)
                                 Output: (PARTIAL count())
                                 DuckDB: Agg over 1 leaf
                                 DuckDB SQL: SELECT * FROM (SELECT CAST(count(*) AS BIGINT) AS c1 FROM (SELECT * FROM gg_leaf(0)) AS n1) AS n2
                                 ->  Seq Scan on public.p_b
         ->  Seq Scan on public.p_a
               Output: p_a.k
 Optimizer: GPORCA
 Settings: effective_cache_size = '512MB'
(21 rows)

SET gg_duckdb.explain_decisions = off;
SELECT p_check($q$ SELECT k, count(*) AS n FROM p_a GROUP BY k HAVING count(*) > (SELECT count(*) FROM p_b) / 100 $q$);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
