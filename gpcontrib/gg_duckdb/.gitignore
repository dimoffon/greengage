*.o
*.so
/.deps/
/log/
/results/
/tmp_check/
/regression.diffs
/regression.out
/data/*
!/data/.gitkeep
/sql/foreign.sql
/expected/foreign.out
/expected/foreign_optimizer.out
/sql/write.sql
/expected/write.out
/expected/write_optimizer.out
/bench/tpcds/queries/
/bench/tpcds/results/
/bench/redset/results/

# The root .gitignore has a bare "build.sh" pattern, which would swallow the
# recipe that produces the DuckDB prefix this directory is built against.
!duckdb/build.sh
